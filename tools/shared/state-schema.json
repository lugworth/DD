{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Digidelic Tool Project State",
  "version": 1,
  "type": "object",
  "required": ["toolId", "engineVersion", "schemaVersion", "seed", "settings", "content", "simulationState", "assets", "createdAt", "updatedAt"],
  "properties": {
    "toolId": {"type": "string"},
    "engineVersion": {"type": "string"},
    "schemaVersion": {"type": "integer", "const": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "settings": {"type": "object"},
    "content": {"type": "object"},
    "simulationState": {"type": "object"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "data", "mime"],
        "properties": {
          "type": {"type": "string", "enum": ["image", "video", "audio", "font", "other"]},
          "data": {"type": "string", "description": "base64 data URI"},
          "mime": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}