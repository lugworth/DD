{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "digidelic design system — W3C DTCG design tokens. Generated from colors_and_type.css. Machine-readable surface for AI coding tools and token pipelines.",
  "color": {
    "$type": "color",
    "base": {
      "black":        { "$value": "#000000", "$description": "Universal canvas. Background is pure black — never gradient." },
      "black-soft":   { "$value": "#0a0a0a", "$description": "Page background" },
      "black-panel":  { "$value": "#111110", "$description": "Surface / card" },
      "black-raised": { "$value": "#1a1a18", "$description": "Elevated / disabled fill" },
      "white":        { "$value": "#ffffff", "$description": "Text on black. 21:1" }
    },
    "hero": {
      "cobalt":  { "$value": "#2d6cff", "$description": "PRIMARY action, hero fill, focus ring. 4.70:1 on black; black text on it 4.70:1, white text 4.47:1 — both clear AA." },
      "pink":    { "$value": "#ff2d87", "$description": "Alerts, notifications, glitch. 5.98:1 on black." },
      "pink-hot":{ "$value": "#ff0066", "$description": "Critical errors. 5.44:1 on black." },
      "green":   { "$value": "#39ff6a", "$description": "Success, live. 15.69:1 on black." },
      "blue":    { "$value": "{color.hero.cobalt}", "$description": "Alias of cobalt. The former #2d4cff was indistinguishable from cobalt and failed AA body text, so the two merged." },
      "magenta": { "$value": "#c800ff", "$description": "Glitch overlay, rare accent. 4.90:1 on black." },
      "cyan":    { "$value": "#00d9ff", "$description": "Data readout, links. 12.37:1 on black." }
    },
    "duotone": {
      "sky":   { "$value": "#0a84e0", "$description": "Zine ground, ticker strips. 5.39:1 on black." },
      "coral": { "$value": "#ff6050", "$description": "Checkerboard, dividers, warm alert. 7.04:1 on black." },
      "teal":  { "$value": "#12b39b", "$description": "Duotone third. 7.95:1 on black." },
      "lime":  { "$value": "#c6ff3a", "$description": "Spirograph line overlays." },
      "orange":{ "$value": "#ff5a00", "$description": "Warning. 6.71:1 on black." }
    },
    "night": {
      "night":  { "$value": "#150a1c", "$description": "Deep violet night sky — alt hero ground" },
      "violet": { "$value": "#8a3fb0" },
      "indigo": { "$value": "#4653e8" },
      "blood":  { "$value": "#e02020" }
    },
    "secondSet": {
      "$description": "Deep, muted family sampled from the reference plates. Parallel to the ten-stop rainbow — these NEVER participate in seeded hue. Plates, editorial and full-bleed grounds only.",
      "blush":     { "$value": "#d798a7", "$description": "Dusty mid pink. Black ink, 8.94:1." },
      "oxblood":   { "$value": "#962c38", "$description": "Deep crimson. White ink, 7.74:1." },
      "botanical": { "$value": "#3f6b45", "$description": "Leaf green. White ink, 6.18:1." },
      "teal":      { "$value": "#03888c", "$description": "Dark cyan. Black ink, 4.90:1." },
      "redTrue":   { "$value": "#ff0026", "$description": "Signal red. Black ink, 5.28:1." },
      "electric":  { "$value": "#0008ff", "$description": "Pure blue. White ink, 8.47:1." }
    },
    "cream": {
      "$description": "The third surface. Warm chalk — reads as paper, not screen. Ink on a cream-surface fill is ALWAYS white.",
      "cream":    { "$value": "#e8e3d0", "$description": "Ground. Black body ink clears 16.33:1." },
      "panel":    { "$value": "#f2efe4" },
      "raised":   { "$value": "#ffffff" },
      "fg":       { "$value": "#0a0a0a" },
      "rule":     { "$value": "rgba(10,10,10,0.26)" },
      "magenta":  { "$value": "#c000f5" },
      "pink":     { "$value": "#db2774" },
      "coral":    { "$value": "#c84b3f" },
      "orange":   { "$value": "#cd4800" },
      "lime":     { "$value": "#627e1d" },
      "green":    { "$value": "#1e8638" },
      "cyan":     { "$value": "#008096" },
      "cobalt":   { "$value": "#2c6afb" },
      "indigo":   { "$value": "#4653e8", "$description": "Already dark enough — authored hex kept." },
      "violet":   { "$value": "#8a3fb0", "$description": "Already dark enough — authored hex kept." }
    },
    "fg": {
      "default": { "$value": "{color.base.white}" },
      "soft":    { "$value": "rgba(255,255,255,0.86)", "$description": "Body copy. AAA." },
      "muted":   { "$value": "rgba(255,255,255,0.55)", "$description": "Secondary labels. 6.25:1 — the readable floor. Never go lower for informational text." },
      "faint":   { "$value": "rgba(255,255,255,0.35)", "$description": "DECORATIVE ONLY. 3.00:1 — fails AA. Rules, dividers, non-informational marks." },
      "ghost":   { "$value": "rgba(255,255,255,0.12)", "$description": "Hairline borders only." },
      "on-color":{ "$value": "{color.base.black}", "$description": "Text on any brand fill always flips to black." }
    },
    "border": {
      "default": { "$value": "rgba(255,255,255,0.12)", "$description": "The only default border treatment. 1px." },
      "hi":      { "$value": "rgba(255,255,255,0.25)" },
      "solid":   { "$value": "{color.base.white}" }
    },
    "status": {
      "ok":    { "$value": "{color.hero.green}" },
      "alert": { "$value": "{color.hero.pink}" },
      "error": { "$value": "{color.hero.pink-hot}" },
      "warn":  { "$value": "{color.duotone.orange}", "$description": "Cobalt is not a hazard signal — warning is orange." },
      "info":  { "$value": "{color.hero.cyan}" }
    },
    "focus": {
      "ring":       { "$value": "{color.hero.cobalt}", "$description": "2px solid, 1px offset. Never removed." },
      "ring-on-cobalt": { "$value": "{color.base.white}", "$description": "Ring flips to white on cobalt fills." }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Space Grotesk", "system-ui", "sans-serif"], "$description": "Uppercase tracked headlines" },
    "mono":    { "$value": ["Geist Mono", "Red Hat Mono", "monospace"], "$description": "PRIMARY — UI, labels, terminal, coordinates, data" }
  },
  "fontSize": {
    "$type": "dimension",
    "2xs": { "$value": "10px" }, "xs":  { "$value": "11px" }, "sm":  { "$value": "12px" },
    "md":  { "$value": "14px" }, "lg":  { "$value": "16px" }, "xl":  { "$value": "20px" },
    "2xl": { "$value": "28px" }, "3xl": { "$value": "40px" }, "4xl": { "$value": "56px" },
    "5xl": { "$value": "80px" }, "6xl": { "$value": "120px" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 }, "semibold": { "$value": 600 },
    "bold": { "$value": 700 }, "black": { "$value": 900 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.02em" }, "normal": { "$value": "0" },
    "wide": { "$value": "0.06em" }, "wider": { "$value": "0.12em" },
    "widest": { "$value": "0.22em", "$description": "Section labels — // LIKE THIS" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base unit",
    "1": { "$value": "4px" },  "2": { "$value": "8px" },  "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" },
    "12": { "$value": "48px" },"16": { "$value": "64px" },"20": { "$value": "80px" },"24": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "default": { "$value": "0", "$description": "Zero radius. Universal. No exceptions." }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "60ms" }, "fast": { "$value": "100ms", "$description": "Hover / press" },
    "base": { "$value": "160ms", "$description": "Entrances, panel transitions" }, "slow": { "$value": "260ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "snap": { "$value": [0.2, 0, 0, 1], "$description": "Hovers, taps" },
    "flow": { "$value": [0.16, 1, 0.3, 1], "$description": "Entrances, the tactile press offset" }
  },
  "elevation": {
    "$description": "There are no soft shadows in this system. Depth is a hard offset block, like a printed layer.",
    "hover":      { "$value": "3px 3px 0 0 rgba(255,255,255,0.30)", "$description": "Paired with transform: translate(-2px,-2px)" },
    "hover-card": { "$value": "4px 4px 0 0 rgba(255,255,255,0.12)" },
    "active":     { "$value": "none", "$description": "Press snaps to translate(0,0), shadow gone." }
  },
  "target": {
    "$type": "dimension",
    "min":    { "$value": "24px", "$description": "WCAG 2.5.8 floor" },
    "touch":  { "$value": "44px", "$description": "Mobile default" }
  }
}
