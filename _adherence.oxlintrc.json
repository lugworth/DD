{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/Badge/**",
              "components/Button/**",
              "components/Card/**",
              "components/Field/**",
              "components/NodeCard/**",
              "components/Progress/**",
              "glitch.js",
              "tailwind.config.js",
              "tweaks-panel.jsx",
              "ui_kits/pantry/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist Mono|Red Hat Mono|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Geist Mono, Red Hat Mono, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|id|accent|status|variant|size|surface|signal|geometry|glitch|pip|dot|checker|count|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, label, id, accent, status, variant, size, surface, signal, geometry, glitch, pip, dot, checker, count, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|quiet|danger)$/]",
        "message": "<Badge> variant must be one of 'solid' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|id|accent|variant|size|surface|signal|geometry|glitch|texture|animation|disabled|pip|checker|icon|block|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, label, id, accent, variant, size, surface, signal, geometry, glitch, texture, animation, disabled, pip, checker, icon, block, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'solid' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|label|id|accent|surface|variant|signal|geometry|glitch|texture|padding|strip|rule|interactive|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, title, label, id, accent, surface, variant, signal, geometry, glitch, texture, padding, strip, rule, interactive, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:panel|raised|flat|accent|outline)$/]",
        "message": "<Card> variant must be one of 'panel' | 'raised' | 'flat' | 'accent' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|help|error|children|id|accent|surface|geometry|required|className|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, help, error, children, id, accent, surface, geometry, required, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|code|rows|status|load|id|accent|surface|signal|geometry|glitch|strip|interactive|width|onClick|children|className|style|key|ref|className|style|children)$/]",
        "message": "<NodeCard> doesn't accept that prop. Declared props: name, code, rows, status, load, id, accent, surface, signal, geometry, glitch, strip, interactive, width, onClick, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|id|accent|surface|size|geometry|indeterminate|showValue|className|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, label, note, id, accent, surface, size, geometry, indeterminate, showValue, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
